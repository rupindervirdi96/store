NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (must be a replica set — Atlas always is — for order transactions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/store?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (web storefront + admin)
CORS_ORIGINS=http://localhost:3000
# Optional: show Google reviews on the home page.
# Enable "Places API (New)" in Google Cloud, create an API key restricted to that API,
# and find your Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Stripe payments (use sk_test_... keys until you go live).
# Webhook endpoint: https://<your-api>/api/v1/payments/webhook
#   events: checkout.session.completed, checkout.session.expired,
#           checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#           charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Storefront customers return to after paying (defaults to the first non-localhost CORS origin)
WEB_URL=http://localhost:3000
# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
