NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (must be a replica set — Atlas always is — for order transactions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/store?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (web storefront + admin)
CORS_ORIGINS=http://localhost:3000
# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
