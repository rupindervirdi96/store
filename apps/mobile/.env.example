# Render API URL. For a local API use your machine's LAN IP (e.g. http://192.168.1.20:4000);
# the Android emulator can also use http://10.0.2.2:4000.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Web storefront URL; menu images are served from its /images folder.
EXPO_PUBLIC_ASSET_URL=http://localhost:3000
